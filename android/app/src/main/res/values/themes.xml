<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主主题：Compose 负责全部绘制，这里只控制窗口底色与系统栏。
         AppCompat 主题是需要的：androidx.biometric 1.1.0 的 BiometricPrompt 需要 FragmentActivity，
         而 ZXing 的扫码 Activity 也复用 AppCompat 主题。 -->
    <style name="Theme.TCUnlock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/tc_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 覆盖 zxing-android-embedded 自带的扫码主题，保持深色无 ActionBar 的简洁观感 -->
    <style name="zxing_CaptureTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
